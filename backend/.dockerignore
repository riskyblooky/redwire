# Keep runtime data, secrets and dev artefacts out of the backend image.
# (Dev bind-mounts ./backend over /app, so tests still run there.)

# Runtime data — bind-mounted / in MinIO, never baked in
uploads/
evidence/

# Secrets
.env
.env.*

# Dev-only data generators: the demo engagement (drives the REST API from
# outside) and the stress-test bulk seed. seed_defaults / seed_templates /
# seed_testcase_templates / seed_permissions are startup code and stay.
seed_demo.py
seed_bulk.py

# Tests and their output
tests/
.pytest_cache/
pytest.ini
pytest_out*.txt
test_report*.pdf

# Python / tooling cruft
__pycache__/
**/__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.venv/
venv/
Dockerfile
.dockerignore
